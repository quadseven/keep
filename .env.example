# Every key Keep reads. All values here are placeholders.

# Sign-in. With no token, no CIDRs or no allowed identity, nobody gets in.
KEEP_PROXY_TOKEN=YOUR_PROXY_SHARED_SECRET_HERE
KEEP_TRUSTED_PROXY_CIDRS=192.0.2.0/31 198.51.100.0/31
KEEP_ALLOWED_LOGINS=operator@example.com
KEEP_ALLOWED_NODES=YOUR_TAILSCALE_STABLE_NODE_ID_HERE
KEEP_TAILSCALED_SOCKET=/var/run/tailscale/tailscaled.sock

# Seconds between collection runs.
KEEP_COLLECT_INTERVAL_SECONDS=900

# Action1. The API base URL differs by Action1 data region.
KEEP_ACTION1_BASE_URL=https://app.action1.com/api/3.0
KEEP_ACTION1_CLIENT_ID=YOUR_ACTION1_CLIENT_ID_HERE
KEEP_ACTION1_CLIENT_SECRET=YOUR_ACTION1_CLIENT_SECRET_HERE

# UniFi Network, local console API. Set the pin when the console has a
# self-signed certificate; with no pin the certificate is verified normally.
KEEP_UNIFI_BASE_URL=https://192.0.2.1
KEEP_UNIFI_API_KEY=YOUR_UNIFI_API_KEY_HERE
KEEP_UNIFI_CERT_SHA256=YOUR_CONSOLE_CERT_SHA256_HEX_HERE
KEEP_UNIFI_SITE=default
